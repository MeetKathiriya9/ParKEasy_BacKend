# ParkEasy API - environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- Application ---
APP_NAME=ParkEasy API
ENVIRONMENT=development
DEBUG=true
VERSION=0.1.0

# --- Database (MongoDB) ---
# Local MongoDB 7.0 Community running as a Windows service on 127.0.0.1:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=parkeasy
# Set to true only for M0 Atlas free clusters (it forces TLS + srv resolution)
MONGODB_TLS=false

# --- Auth (JWT access token, Bearer header) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
JWT_ISSUER=parkeasy

# --- CORS ---
# Comma-separated list of trusted frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Server ---
HOST=127.0.0.1
PORT=9999
RELOAD=true

# --- Logging ---
LOG_LEVEL=INFO
