# ParkEasy API - environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- Application ---
APP_NAME=ParkEasy API
ENVIRONMENT=development
DEBUG=true
VERSION=0.1.0

# --- Database (MongoDB) ---
# Local MongoDB 7.0 Community running as a Windows service on 127.0.0.1:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=parkeasy
# Set to true only for M0 Atlas free clusters (it forces TLS + srv resolution)
MONGODB_TLS=false

# --- Auth (JWT access token, Bearer header) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
JWT_ISSUER=parkeasy

SELF_REGISTER_ROLES=driver,staff,operator,admin

# Brute-force protection on the auth endpoints, per process.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600
# Reset requests are the easiest endpoint to abuse for email bombing, so the
# window is an hour rather than a minute.
FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_WINDOW_SECONDS=3600
RESET_PASSWORD_RATE_LIMIT=10
RESET_PASSWORD_RATE_WINDOW_SECONDS=3600
CHANGE_PASSWORD_RATE_LIMIT=5
CHANGE_PASSWORD_RATE_WINDOW_SECONDS=900
# Profile edits and photo writes, per user.
PROFILE_UPDATE_RATE_LIMIT=20
PROFILE_UPDATE_RATE_WINDOW_SECONDS=3600
AVATAR_UPLOAD_RATE_LIMIT=10
AVATAR_UPLOAD_RATE_WINDOW_SECONDS=3600
# Vehicle create/edit/delete/default switches, per user.
VEHICLE_WRITE_RATE_LIMIT=60
VEHICLE_WRITE_RATE_WINDOW_SECONDS=3600
# Facility create/edit/delete/status changes, per operator.
FACILITY_WRITE_RATE_LIMIT=60
FACILITY_WRITE_RATE_WINDOW_SECONDS=3600
# Floor/zone/space setup writes, per operator. Higher than facilities because a
# layout build touches many documents in a row.
SPACE_WRITE_RATE_LIMIT=120
SPACE_WRITE_RATE_WINDOW_SECONDS=3600

# --- Vehicles ---
# How many vehicles one account may register. Reaching the ceiling answers
# 409 VEHICLE_LIMIT_REACHED rather than silently accepting more.
VEHICLE_MAX_PER_USER=20

# --- Facilities ---
# How many facilities one operator account may hold. Reaching the ceiling
# answers 409 FACILITY_LIMIT_REACHED.
FACILITY_MAX_PER_OPERATOR=50

# --- Staff ---
# How many staff accounts one operator may own. Reaching the ceiling answers
# 409 STAFF_LIMIT_REACHED.
STAFF_WRITE_RATE_LIMIT=60
STAFF_WRITE_RATE_WINDOW_SECONDS=3600
STAFF_MAX_PER_OPERATOR=100

# --- Parking spaces ---
# Layout ceilings. Each answers 409 rather than growing a structure without
# bound; a facility's capacity is derived from its spaces, so these also bound
# how large one facility's capacity can get.
FLOOR_MAX_PER_FACILITY=50
ZONE_MAX_PER_FLOOR=100
SPACE_MAX_PER_ZONE=1000
# Largest single bulk run (e.g. A-01..A-500). Answered with 422, since it is a
# request-shape limit rather than a stored-state conflict.
SPACES_BULK_MAX=500

# --- Parking discovery ---
# Nearby search is a read, but it is also the most expensive query the server
# runs, so it gets a bucket of its own rather than sharing the write limits.
PARKING_SEARCH_RATE_LIMIT=120
PARKING_SEARCH_RATE_WINDOW_SECONDS=3600
# How far a driver looks when they do not say, and the ceiling that stops one
# request from asking the database to scan a whole continent.
PARKING_SEARCH_DEFAULT_RADIUS_KM=5.0
PARKING_SEARCH_MAX_RADIUS_KM=25.0
# Ceiling on one page of results, so `limit` cannot pull the whole city in one
# round trip.
PARKING_SEARCH_MAX_LIMIT=50

# --- Profile photo ---
# Uploads are always decoded and re-encoded server-side, so the upload
# directory only ever contains small, server-generated progressive JPEGs
# whatever the client sent. The stored name is opaque and random; it is never
# derived from the client's filename.
AVATAR_MAX_BYTES=2097152
AVATAR_MAX_PIXELS=25000000
AVATAR_MAX_DIMENSION=512
AVATAR_JPEG_QUALITY=82
# Relative paths are resolved against Server/ and are gitignored.
AVATAR_DIR=uploads/avatars

# Global request body ceiling, enforced before routing. Kept comfortably above
# AVATAR_MAX_BYTES so an oversized photo gets the route's specific 400 while a
# genuinely abusive body is refused outright with a 413.
MAX_REQUEST_BODY_BYTES=4194304

# --- Password reset ---
# Tokens are emailed, single-use, and stored only as a sha256 hash.
PASSWORD_RESET_EXPIRES_MINUTES=30
PASSWORD_RESET_TOKEN_BYTES=32

# --- Email ---
# console = write the message to the server log (default; no mailbox needed).
# smtp    = really send it. Requires the SMTP_* values below to be complete,
#           otherwise the app logs a warning and falls back to console.
EMAIL_TRANSPORT=console
EMAIL_FROM=no-reply@parkeasy.local
EMAIL_FROM_NAME=ParkEasy
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Origin that emailed reset links point at. Server-side config only -- this is
# never read from a request, or a caller could aim someone else's reset token
# at a host they control.
CLIENT_BASE_URL=http://localhost:5173

# --- CORS ---
# Comma-separated list of trusted frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Server ---
HOST=127.0.0.1
PORT=9999
RELOAD=true

# --- Logging ---
LOG_LEVEL=INFO
